            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Resource control identifier"
              }
            ]
          },
          "docs": "Update a resource control\n**Access policy**: authenticated"
        },
        {
          "info": {
            "name": "Remove a resource control",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/resource_controls/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Resource control identifier"
              }
            ]
          },
          "docs": "Remove a resource control.\n**Access policy**: administrator"
        }
      ]
    }
