        },
        {
          "info": {
            "name": "Create a custom template",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/custom_templates/create/repository"
          },
          "docs": "Create a custom template.\n**Access policy**: authenticated"
